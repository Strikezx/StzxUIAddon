# How the release zip is built (BigWigsMods/packager).
# The repo holds several addon folders; each becomes its own folder in AddOns.
package-as: StzxUI

move-folders:
  StzxUI/StzxUI: StzxUI
  StzxUI/StzxUI_Social: StzxUI_Social
  StzxUI/StzxUI_Info: StzxUI_Info
  StzxUI/StzxUI_UnitFrames: StzxUI_UnitFrames
  StzxUI/StzxUI_Quests: StzxUI_Quests
  StzxUI/StzxUI_Runs: StzxUI_Runs
  StzxUI/StzxUI_Fishing: StzxUI_Fishing
  StzxUI/StzxUI_ActionBars: StzxUI_ActionBars
  StzxUI/StzxUI_Nameplates: StzxUI_Nameplates
  StzxUI/StzxUI_Blizzard: StzxUI_Blizzard
  StzxUI/StzxUI_Inventory: StzxUI_Inventory
  StzxUI/StzxUI_Minimap: StzxUI_Minimap
  StzxUI/StzxUI_Skins: StzxUI_Skins
  StzxUI/StzxUI_Helpers: StzxUI_Helpers

ignore:
  - docs
  - tests
  - README.md
  - CLAUDE.md
  - .luacheckrc
  - .editorconfig
